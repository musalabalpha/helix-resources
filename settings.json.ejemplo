{
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(yarn test:*)",
      "Bash(pnpm test:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(chmod -R 777*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); printf '%s' \"$payload\" | grep -qE 'rm +-[a-zA-Z]*[rf][a-zA-Z]* +(/|~|[.])|git +push +(--force|-f)|git +reset +--hard' && { echo 'Bloqueado por hook: comando destructivo. Pide confirmacion explicita al usuario antes de reintentar.' >&2; exit 2; }; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Contexto de sesion: revisar ~/.claude/memory/MEMORY.md antes de asumir estado del proyecto.'"
          }
        ]
      }
    ]
  }
}
